# Copy to `.env` and adjust. Every setting is also settable as a real
# environment variable, which is what production should do (12-factor).
# All variables are prefixed with M4D_.

# ---- Application -----------------------------------------------------------
M4D_ENVIRONMENT=local
M4D_DEBUG=true
M4D_LOG_LEVEL=INFO
# json (production) | console (human-readable, for local development)
M4D_LOG_FORMAT=console

# ---- HTTP ------------------------------------------------------------------
M4D_API_HOST=0.0.0.0
M4D_API_PORT=8000
# Comma-separated. Leave empty to disable CORS entirely.
M4D_CORS_ORIGINS=

# ---- Database --------------------------------------------------------------
# Must use the asyncpg driver.
M4D_DATABASE_URL=postgresql+asyncpg://postgres@127.0.0.1:5432/m4d
M4D_DB_POOL_SIZE=5
M4D_DB_MAX_OVERFLOW=10
M4D_DB_ECHO=false
M4D_DB_CONNECT_TIMEOUT_SECONDS=5.0
M4D_DB_STATEMENT_TIMEOUT_MS=10000
