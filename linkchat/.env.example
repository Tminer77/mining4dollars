# LinkChat configuration. Copy to .env and edit.
# Nothing here is written to disk by the app, put in a link, or logged.

# --- identity ---------------------------------------------------------------
LINKCHAT_DISPLAY_NAME=Anonymous
LINKCHAT_DATA_DIR=.linkchat/default
# Wraps the private key with scrypt + AES-256-GCM. Set it BEFORE first start;
# without it the key is stored in the clear, protected only by file mode 0600.
# LINKCHAT_KEY_PASSPHRASE=

# --- local UI ---------------------------------------------------------------
# Bound to 127.0.0.1 and protected by a token printed at startup.
LINKCHAT_UI_PORT=0

# --- peer to peer -----------------------------------------------------------
# 0 asks the OS for a free port. The advertise host is what goes in invite
# links, so it must be an address other machines can actually reach; there is
# no NAT traversal.
LINKCHAT_P2P_PORT=0
# LINKCHAT_ADVERTISE_HOST=192.168.1.20

# Origin used when minting invite links. Cosmetic: only the path and fragment
# carry meaning.
LINKCHAT_LINK_ORIGIN=https://linkchat.local

# --- SMTP transport ---------------------------------------------------------
# Sending. Leave unset to run without SMTP (P2P only). Use a submission
# service; port 25 is blocked outbound on most networks.
# LINKCHAT_SMTP_HOST=smtp.example.com
# LINKCHAT_SMTP_PORT=587
# LINKCHAT_SMTP_SECURE=false          # true for implicit TLS on 465
# LINKCHAT_SMTP_USER=
# LINKCHAT_SMTP_PASS=
# LINKCHAT_SMTP_FROM=you@example.com

# The address peers are told to deliver to. Usually the same as _FROM.
# LINKCHAT_SMTP_ADDRESS=you@example.com

# Receiving. SMTP cannot pull, so pick one:
#   (a) this node runs its own SMTP listener for a self-hosted MX to relay into
# LINKCHAT_SMTP_LISTEN_PORT=7501
#   (b) an external delivery agent (fetchmail, getmail, mbsync) writes RFC 5322
#       files into a maildir that this node watches
# LINKCHAT_MAILDIR=/var/mail/linkchat

# Local development only: allows a plaintext relay with no TLS at all.
# LINKCHAT_SMTP_ALLOW_INSECURE=false

# --- development ------------------------------------------------------------
# Shared directory used by the dev MTA to find each node's SMTP listener.
# Stands in for DNS MX lookup. Not used with a real relay.
# LINKCHAT_DEV_SHARED=.linkchat/dev
